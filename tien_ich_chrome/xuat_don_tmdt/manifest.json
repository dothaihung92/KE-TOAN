{
  "manifest_version": 3,
  "name": "Kế toán - Xuất hoá đơn TMĐT & sao kê ngân hàng",
  "version": "1.52",
  "description": "Kế toán: xuất đơn Shopee/TikTok/Lazada, lấy HĐ MISA, tự xuất Excel sao kê ngân hàng (VCB, ACB, VietinBank, Techcombank).",
  "content_scripts": [
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://accounts.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "dau.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*"
      ],
      "js": [
        "giu_blob.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://accounts.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "chay.js",
        "misa.js",
        "tu_dong.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.vietcombank.com.vn/*",
        "https://*.acb.com.vn/*",
        "https://*.vietinbank.vn/*",
        "https://*.techcombank.com.vn/*",
        "https://*.techcombank.com/*"
      ],
      "js": [
        "ngan_hang.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "nen.js"
  },
  "permissions": [
    "cookies",
    "debugger",
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://*.lazada.vn/*",
    "https://*.acb.com.vn/*",
    "https://*.vietcombank.com.vn/*",
    "https://*.vietinbank.vn/*",
    "https://*.techcombank.com.vn/*",
    "https://*.techcombank.com/*",
    "http://127.0.0.1/*"
  ]
}
