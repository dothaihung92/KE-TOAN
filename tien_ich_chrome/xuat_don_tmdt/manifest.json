{
  "manifest_version": 3,
  "name": "Kế toán - Xuất hoá đơn TMĐT",
  "version": "1.37",
  "description": "Phần mềm kế toán: tự đăng nhập đúng tài khoản sàn của công ty, xuất và tải đơn Shopee/TikTok/Lazada; lấy danh sách HĐ MISA.",
  "content_scripts": [
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://accounts.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "dau.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://accounts.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "chay.js",
        "misa.js",
        "tu_dong.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "nen.js"
  },
  "permissions": [
    "cookies",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "https://*.shopee.vn/*",
    "https://*.tiktok.com/*",
    "https://*.lazada.vn/*",
    "http://127.0.0.1/*"
  ]
}