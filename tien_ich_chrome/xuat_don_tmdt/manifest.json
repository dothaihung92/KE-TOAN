{
  "manifest_version": 3,
  "name": "Kế toán - Xuất hoá đơn TMĐT",
  "version": "1.13",
  "description": "Khi phần mềm kế toán mở trang Quản lý đơn hàng Shopee/TikTok Shop/Lazada: tự chọn ngày, bấm Xuất báo cáo và Tải về; trên MISA meInvoice: tự bấm xuất danh sách hoá đơn. Chỉ bấm nút trên trang, không đọc mật khẩu, không gửi dữ liệu đi đâu.",
  "content_scripts": [
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "dau.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://banhang.shopee.vn/*",
        "https://seller-vn.tiktok.com/*",
        "https://sellercenter.lazada.vn/*",
        "https://*.meinvoice.vn/*"
      ],
      "js": [
        "chay.js",
        "misa.js",
        "tu_dong.js"
      ],
      "run_at": "document_idle"
    }
  ]
}